<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.scene.text.Text?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.cafeteria.HelloController"
      stylesheets="@styles.css"
      fx:id="panel" spacing="20" alignment="CENTER">

    <HBox spacing="40" alignment="CENTER">
        <Button text="Iniciar turno" fx:id="btnIniciar" onAction="#iniciarTurno"/>
        <Button text="Salir" fx:id="btnSalir" onAction="#salirDelPrograma"/>
    </HBox>

    <TextArea fx:id="textoDelPanel" prefWidth="450" maxWidth="450"
              prefHeight="600" maxHeight="600" editable="false"/>
</VBox>

